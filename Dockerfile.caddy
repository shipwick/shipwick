# syntax=docker/dockerfile:1

# Shipwick's reverse proxy: Caddy with the Cloudflare DNS provider and with
# Shipwick's own source of replicas (caddy/), and nothing else added.
#
#   docker build -t ghcr.io/shipwick/caddy -f Dockerfile.caddy .
#
# The official image has no DNS providers, and a certificate for a hostname
# behind Cloudflare's proxy, or for a wildcard, can only be obtained through a
# DNS record. Every installation runs this image, with or without a Cloudflare
# token: one proxy to test, and turning Cloudflare on is one variable.
#
# Both versions are pinned. The agent generates this Caddy's configuration, and
# a newer Caddy or module is a change to test, not something a rebuild brings
# along. The second stage starts from the official image of the version the
# first one builds, so everything but the binary is the official image's.

# caddy/go.mod names the same Caddy: the module is compiled against the Caddy
# it is built into, and CI fails when the two disagree.
ARG CADDY_VERSION=2.11.6

# The build stage runs on the builder's own architecture and cross-compiles:
# pure Go, so a multi-platform build needs no emulation.
FROM --platform=$BUILDPLATFORM caddy:${CADDY_VERSION}-builder-alpine AS build
ARG CADDY_VERSION
ARG CLOUDFLARE_DNS_VERSION=v0.2.4
ARG TARGETOS TARGETARCH
COPY caddy /src/caddy
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH xcaddy build "v${CADDY_VERSION}" \
      --with "github.com/caddy-dns/cloudflare@${CLOUDFLARE_DNS_VERSION}" \
      --with "github.com/shipwick/shipwick/caddy=/src/caddy" \
      --output /out/caddy

FROM caddy:${CADDY_VERSION}-alpine
COPY --from=build /out/caddy /usr/bin/caddy
