# Copy to .env for local development:  cp .env.example .env
#
# `npm run dev` reads .env automatically. The production server does not:
# pass real environment variables (or `node --env-file=.env .output/server/index.mjs`).

# Where the dashboard's server finds the Shipwick agent. The browser never
# talks to this address; only the Nitro server does.
#
#   mock agent (npm run mock):   http://127.0.0.1:9100   token: mock-token-0123456789abcdef
#   local agent (docker compose): http://127.0.0.1:9000   token: dev-token-do-not-use-in-production
SHIPWICK_AGENT_URL=http://127.0.0.1:9100

# Optional. The session cookie is marked Secure automatically when the request
# arrived over https (directly or via X-Forwarded-Proto). Force it on or off:
# SHIPWICK_COOKIE_SECURE=true

# Optional. Address and port of the production server (Nitro defaults: 0.0.0.0:3000).
# HOST=0.0.0.0
# PORT=3000
