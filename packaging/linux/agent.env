# Settings of the Shipwick agent, read by shipwick-agent.service. After a
# change:  systemctl restart shipwick-agent
#
# One NAME=value a line, without quotes. Keep this file private: the token is
# root on this server. Every variable is described in the handbook, §4:
# https://github.com/shipwick/shipwick/blob/main/docs/handbook.md

# The API token: what the CLI and the dashboard sign in with. Generated when
# the package was installed.
SHIPWICK_AGENT_TOKEN=

# Where the API listens. Loopback reaches it from this server only: the CLI
# here, or an SSH tunnel. The proxy and the dashboard are containers and reach
# the server at the address of the Docker bridge: to serve the API at a
# hostname, or to use the dashboard, listen there instead (the address is
# shown by:  ip -4 addr show docker0). The API is plain HTTP: never a public
# address.
SHIPWICK_LISTEN_ADDR=127.0.0.1:9000
#SHIPWICK_LISTEN_ADDR=172.17.0.1:9000

# The reverse proxy, started from /usr/share/shipwick/compose.yml. Its admin
# socket is shared through /run/shipwick, and its TLS port is where the agent
# reads the certificates it serves. Without a proxy, comment both out.
SHIPWICK_CADDY_ADMIN=unix//run/shipwick/admin.sock
SHIPWICK_PROXY_TLS_ADDR=127.0.0.1:443

# Hostnames for the API and the dashboard, served over HTTPS by the proxy.
# Both need the listen address of the Docker bridge, above.
#SHIPWICK_AGENT_DOMAIN=agent.example.com
#SHIPWICK_DASHBOARD_DOMAIN=dashboard.example.com

SHIPWICK_LOG_FORMAT=text
